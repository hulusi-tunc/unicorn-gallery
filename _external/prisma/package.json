{
	"name": "prisma",
	"version": "0.1.0",
	"description": "Prisma — visual flow testing & macro recorder using the host WebKit",
	"type": "module",
	"scripts": {
		"start": "electrobun dev",
		"dev": "electrobun dev --watch",
		"build": "electrobun build",
		"build:canary": "electrobun build --env=canary",
		"build:stable": "electrobun build --env=stable",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"ci": "biome check src/ && electrobun build"
	},
	"dependencies": {
		"electrobun": "^1.18.1",
		"js-yaml": "^4.1.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/bun": "^1.3.8",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.0.0"
	}
}
