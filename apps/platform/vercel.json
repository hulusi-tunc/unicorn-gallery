{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @unicorn-studio/gallery-capture build && pnpm --filter @unicorn-studio/gallery-platform build",
  "crons": [
    {
      "path": "/api/cron/hard-delete-archived",
      "schedule": "0 4 * * *"
    }
  ]
}
