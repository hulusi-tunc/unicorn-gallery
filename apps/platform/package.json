{
  "name": "@unicorn-studio/gallery-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant Mobbin-style gallery platform. Apps grid + per-app dashboards + comments + admin + Supabase magic-link auth.",
  "scripts": {
    "dev": "next dev -p 3010",
    "dev:clean": "rm -rf .next && next dev -p 3010",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start -p 3010",
    "typecheck": "tsc --noEmit",
    "fixture:gen": "tsx scripts/gen-fixture.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "tokens": "tsx scripts/show-tokens.ts",
    "release:publish": "tsx scripts/publish-release.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@unicorn-studio/gallery-capture": "workspace:*",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.49.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
