{
  "manifest_version": 3,
  "name": "Unicorn Capture",
  "short_name": "Capture",
  "description": "Snap web screens straight into the Unicorn Studio gallery — viewport, full page, PDF and short clips, filed to a project and flow.",
  "version": "0.0.1",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Unicorn Capture",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "debugger",
    "tabCapture",
    "downloads",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:9876/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
